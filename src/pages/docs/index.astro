---
import { getCollection, getEntry } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Sidebar from '../../components/Sidebar.astro';

const allDocs = await getCollection('docs');
const docs = allDocs
  .filter((entry) => entry.id !== 'README')
  .map((entry) => ({
    slug: entry.data.slug,
    section: entry.data.section,
    sourcePath: entry.data.sourcePath,
  }));

// `docs/README.tmt` is the map the repo's own AGENTS.md points contributors
// at, so it is the natural landing page for the documentation section.
const landing = await getEntry('docs', 'README');
const html = landing?.rendered?.html ?? '';
const title = landing?.data?.title ?? 'ドキュメント';
const toc = landing?.data?.toc ?? [];
---

<BaseLayout title={`${title} — Tomet`} nav="docs">
  <div class="layout">
    <Sidebar docs={docs as any} current="" />

    <main class="tmt-body">
      <div class="page-meta"><code>docs/README.tmt</code></div>
      <Fragment set:html={html} />
    </main>

    <nav class="toc">
      {
        toc.length > 0 && (
          <>
            <h2>このページ</h2>
            <ul>
              {toc.map((item: { id: string; level: number; text: string }) => (
                <li class={`lvl-${item.level}`}>
                  <a href={`#${item.id}`}>{item.text}</a>
                </li>
              ))}
            </ul>
          </>
        )
      }
    </nav>
  </div>
</BaseLayout>
